<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep-space gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/background"
                android:startColor="@color/background_deep" />
        </shape>
    </item>

    <!-- Pixel stars -->
    <item
        android:width="3dp"
        android:height="3dp"
        android:gravity="top|end"
        android:top="48dp"
        android:right="36dp">
        <shape android:shape="rectangle">
            <solid android:color="#99E9E4FF" />
        </shape>
    </item>

    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="top|end"
        android:top="92dp"
        android:right="112dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC3EE6FF" />
        </shape>
    </item>

    <item
        android:width="4dp"
        android:height="4dp"
        android:gravity="top|start"
        android:top="150dp"
        android:left="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#88FF2E88" />
        </shape>
    </item>

    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="center"
        android:top="220dp"
        android:left="90dp">
        <shape android:shape="rectangle">
            <solid android:color="#99FFD23F" />
        </shape>
    </item>

    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="bottom|start"
        android:bottom="120dp"
        android:left="44dp">
        <shape android:shape="rectangle">
            <solid android:color="#66E9E4FF" />
        </shape>
    </item>

    <item
        android:width="3dp"
        android:height="3dp"
        android:gravity="bottom|end"
        android:bottom="220dp"
        android:right="52dp">
        <shape android:shape="rectangle">
            <solid android:color="#883EE6FF" />
        </shape>
    </item>

</layer-list>
