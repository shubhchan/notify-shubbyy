<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NotifyShubbyy" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/outline_strong</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error_container</item>
        <item name="fontFamily">@font/vt323</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>

    <!-- Arcade buttons: square corners, 2dp black stroke, VT323 labels. -->

    <style name="Widget.NotifyShubbyy.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">2dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/pixel_black</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="fontFamily">@font/vt323</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.NotifyShubbyy.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">2dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/outline_strong</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">@font/vt323</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.NotifyShubbyy.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">2dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/outline_strong</item>
        <item name="backgroundTint">@color/surface_container_high</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">@font/vt323</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="TextAppearance.NotifyShubbyy.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.NotifyShubbyy.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">8sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

</resources>
